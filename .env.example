# DeepSeek API 配置
# 从 https://platform.deepseek.com/ 获取 API Key

# API 密钥 (必需)
DEEPSEEK_API_KEY=your_api_key_here

# API 端点 (可选，如未配置将使用默认值)
# 图片生成 API 地址
DEEPSEEK_IMAGES_API_URL=https://api.deepseek.com/v1/images/generations

# 视频生成 API 地址
DEEPSEEK_VIDEOS_API_URL=https://api.deepseek.com/v1/videos/generations

# 其他配置
NODE_ENV=development
PORT=3001
